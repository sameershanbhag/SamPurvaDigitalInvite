# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Mongo database name (optional, defaults to wedding_invitation)
DATABASE_NAME=wedding_invitation

# Admin dashboard credentials for /dashboard
# NOTE: VITE_* vars are baked into the client bundle at build time — do not use a sensitive password
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=change-me

# Local dev server port (optional, defaults to 5000)
PORT=5000

# Only needed for `npm run db:push` (drizzle-kit, Postgres) — the app itself uses MongoDB
# DATABASE_URL=postgresql://user:password@host:5432/dbname
